    {
      "parameters": {
        "jsCode": "const callbackQuery = $input.item.json.callback_query;\nconst data = callbackQuery?.data || '';\nconst chatId = callbackQuery?.message?.chat?.id;\nconst callbackQueryId = callbackQuery?.id;\nconst msgText = callbackQuery?.message?.text || '';\n\n// callback_data format: \"{action}:{ruleId}:{entityId}\"\nconst [action, ruleId, entityId] = data.split(':');\n\n// Extract rule name and entity name from the alert message\nconst lines = msgText.split('\\n');\nlet rn = (lines[0] || '').replace(/\\[DRY RUN\\]/g, '').replace(/[🛑💥🧪*]/g, '').replace(/^(Pause|Scale_budget|Velocity Kill):\\s*/i, '').trim();\nconst ruleName = rn || 'Rule #' + ruleId;\nconst entityName = (lines[1] || '').replace(/`/g, '').split('|')[0].trim() || entityId;\n\n// For account-scope rules, entityName contains \"(Acct act_XXXX)\" — exemptions are\n// keyed by account ID, so extract it to avoid a mismatch with the batch-check lookup.\nlet exemptionEntityId = entityId;\nconst acctMatch = entityName.match(/\\(Acct (act_\\d+)\\)/);\nif (acctMatch) exemptionEntityId = acctMatch[1];\n\nreturn [{ json: { action, ruleId: parseInt(ruleId), entityId, exemptionEntityId, chatId, callbackQueryId, ruleName, entityName } }];"
      },
      "id": "02a62311-9a21-4fe4-a0ae-65772b7a95ea",
