{
  "name": "Telegram Quick Actions",
  "nodes": [
    {
      "id": "node-tg-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "CONFIGURE_IN_N8N",
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_IN_N8N",
          "name": "CONFIGURE_IN_N8N"
        }
      },
      "parameters": {
        "additionalFields": {}
      }
    },
    {
      "id": "node-is-callback",
      "name": "Is Callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.callback_query }}",
              "rightValue": "",
              "operator": { "type": "object", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-parse-callback",
      "name": "Parse Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 200],
      "parameters": {
        "jsCode": "const callbackQuery = $input.item.json.callback_query;\nconst data = callbackQuery?.data || '';\nconst chatId = callbackQuery?.message?.chat?.id;\nconst callbackQueryId = callbackQuery?.id;\nconst msgText = callbackQuery?.message?.text || '';\n\n// callback_data format: \"{action}:{ruleId}:{entityId}\"\nconst [action, ruleId, entityId] = data.split(':');\n\n// Extract rule name and entity name from the alert message\nconst lines = msgText.split('\\n');\nlet rn = (lines[0] || '').replace(/\\[DRY RUN\\]/g, '').replace(/[🛑💥🧪*]/g, '').replace(/^(Pause|Scale_budget|Velocity Kill):\\s*/i, '').trim();\nconst ruleName = rn || 'Rule #' + ruleId;\nconst entityName = (lines[1] || '').replace(/`/g, '').split('|')[0].trim() || entityId;\n\nreturn [{ json: { action, ruleId: parseInt(ruleId), entityId, chatId, callbackQueryId, ruleName, entityName } }];"
      }
    },
    {
      "id": "node-get-token",
      "name": "Get Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/tokens",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-restore-data",
      "name": "Restore Callback Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200],
      "parameters": {
        "jsCode": "const cb = $('Parse Callback').item.json;\nconst tokens = $input.all().map(i => i.json);\nconst token = tokens[0]?.access_token || null;\nreturn [{ json: { ...cb, token } }];"
      }
    },
    {
      "id": "node-route-action",
      "name": "Route Action",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 200],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.action }}",
              "rightValue": "reenable",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-fb-reenable",
      "name": "Re-enable Entity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 100],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v25.0/{{ $json.entityId }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "status", "value": "ACTIVE" },
            { "name": "access_token", "value": "={{ $json.token }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-clear-pause",
      "name": "Clear Pause Pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 100],
      "parameters": {
        "method": "DELETE",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/pause-pending",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ rule_id: $('Restore Callback Data').item.json.ruleId, entity_id: $('Restore Callback Data').item.json.entityId }) }}",
        "options": { "onError": "continueRegularOutput" }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-snooze",
      "name": "Set Snooze Exemption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/exemptions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ rule_id: $('Restore Callback Data').item.json.ruleId, entity_id: $('Restore Callback Data').item.json.entityId, type: 'snooze', cooldown_hours: 6 }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-log-reenable",
      "name": "Log Re-enable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ rule_id: $('Restore Callback Data').item.json.ruleId, entity_type: 'campaign', entity_id: $('Restore Callback Data').item.json.entityId, entity_name: $('Restore Callback Data').item.json.entityName, action_taken: 'telegram_reenable', trigger_data_json: JSON.stringify({ source: 'telegram', user: $('Restore Callback Data').item.json.chatId }) }) }}",
        "options": { "onError": "continueRegularOutput" }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-confirm-reenable",
      "name": "Confirm Re-enable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 100],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Restore Callback Data').item.json.chatId, text: '✅ Re-enabled `' + $('Restore Callback Data').item.json.entityName + '`', parse_mode: 'Markdown' }) }}",
        "options": {}
      }
    },
    {
      "id": "node-log-snooze",
      "name": "Log Snooze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ rule_id: $('Restore Callback Data').item.json.ruleId, entity_type: 'campaign', entity_id: $('Restore Callback Data').item.json.entityId, entity_name: $('Restore Callback Data').item.json.entityName, action_taken: 'telegram_snooze', trigger_data_json: JSON.stringify({ source: 'telegram', hours: 6, user: $('Restore Callback Data').item.json.chatId }) }) }}",
        "options": { "onError": "continueRegularOutput" }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-confirm-snooze",
      "name": "Confirm Snooze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Restore Callback Data').item.json.chatId, text: '💤 Snoozed *' + $('Restore Callback Data').item.json.ruleName + '* for `' + $('Restore Callback Data').item.json.entityName + '` — 6h exemption set', parse_mode: 'Markdown' }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
