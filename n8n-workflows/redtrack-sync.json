      "id": "055690e9-0f27-4346-955a-ddefc03fa85c",
      "name": "Fetch RT Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "kc8PjCCyMioTHOXg",
          "name": "redtrack"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst bycamp = {};\nfor (const item of items) {\n  const r = item.json;\n  const name = r.rt_campaign;\n  if (!name) continue;\n  if (!bycamp[name]) {\n    bycamp[name] = { campaign_name: name, revenue: 0, profit: 0, conversions: 0, cost: 0, offer_name: r.offer || null };\n  }\n  bycamp[name].revenue += r.revenue || 0;\n  bycamp[name].profit += r.profit || 0;\n  bycamp[name].conversions += r.conversions || 0;\n  bycamp[name].cost += r.cost || 0;\n}\nconst results = Object.values(bycamp).map(c => ({ json: {\n  campaign_name: c.campaign_name,\n  roi: c.cost > 0 ? (c.revenue - c.cost) / c.cost : 0,\n  revenue: c.revenue,\n  profit: c.profit,\n  conversions: c.conversions,\n  offer_name: c.offer_name,\n}}));\nif (results.length === 0) return [{ json: { _empty: true } }];\nreturn results;"
      },
