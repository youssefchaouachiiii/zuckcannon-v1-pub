    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "alert-chat-id",
              "name": "chat_id",
              "value": "={{ $env.TELEGRAM_CHAT_ID }}",
              "type": "string"
            },
            {
              "id": "alert-text",
              "name": "text",
              "value": "={{ (() => { const u = $json.unmatched || []; const esc = s => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); const top = u.slice(0, 10); const rest = Math.max(0, u.length - 10); const lines = top.map(o => '• <b>' + esc(o.offer_name) + '</b>  <i>(' + esc(o.offer_id) + ')</i>'); const more = rest > 0 ? '\\n<i>… +' + rest + ' more</i>' : ''; const link = $env.ZUCKCANNON_URL ? '\\n\\n<a href=\"' + $env.ZUCKCANNON_URL + '/rules-engine\">Open Rules Engine UI →</a>' : ''; return '🏷️ <b>' + u.length + ' offer' + (u.length === 1 ? '' : 's') + ' need vertical assignment</b>\\n' + lines.join('\\n') + more + link; })() }}",
              "type": "string"
            },
            {
              "id": "alert-parse-mode",
              "name": "parse_mode",
              "value": "HTML",
              "type": "string"
            },
            {
              "id": "alert-disable-preview",
              "name": "disable_web_page_preview",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
