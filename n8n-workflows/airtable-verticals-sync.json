{
  "name": "Airtable: Verticals Sync",
  "nodes": [
    {
      "id": "trigger-verticals",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        },
        "triggerAtTimezone": "America/New_York"
      }
    },
    {
      "id": "get-verticals",
      "name": "Get Verticals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/verticals",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-secret", "value": "={{ $env.ZUCKCANNON_SECRET }}" }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "ChO4khvkkZE18mKC", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "transform-verticals",
      "name": "Transform for Airtable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "jsCode": "const verticals = $input.all().map(i => i.json);\nconst nowIso = new Date().toISOString();\nreturn verticals.map(v => ({\n  json: {\n    'ID': v.id,\n    'Name': v.name || '',\n    'Tracks LPV': v.tracks_lpv === 1 || v.tracks_lpv === true,\n    'Keyword': v.keyword || '',\n    'Default Schedule ID': v.default_schedule_id || null,\n    'Synced At': nowIso\n  }\n}));"
      }
    },
    {
      "id": "airtable-upsert-verticals",
      "name": "Airtable: Upsert Verticals",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [960, 300],
      "parameters": {
        "resource": "record",
        "operation": "upsert",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_VERTICALS_TABLE }}",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": ["ID"],
          "schema": [],
          "attemptToConvertTypes": true
        },
        "options": {
          "typecast": true
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_WITH_AIRTABLE_CRED_ID",
          "name": "Airtable Personal Access Token"
        }
      }
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [[{ "node": "Get Verticals", "type": "main", "index": 0 }]]
    },
    "Get Verticals": {
      "main": [[{ "node": "Transform for Airtable", "type": "main", "index": 0 }]]
    },
    "Transform for Airtable": {
      "main": [[{ "node": "Airtable: Upsert Verticals", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
