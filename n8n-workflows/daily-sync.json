    {
      "parameters": {
        "jsCode": "return $input.all()\n  .filter(item => item.json.rt_campaign && item.json.date)\n  .map(item => ({ json: {\n    campaign_name: item.json.rt_campaign,\n    date: item.json.date,\n    revenue: item.json.revenue || 0,\n    profit: item.json.profit || 0,\n    conversions: item.json.conversions || 0,\n    cost: item.json.cost || 0,\n  }}));"
      },
      "id": "a1b2c3d4-0003-4e5f-8a9b-000000000003",
      "name": "Map RT Daily Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
