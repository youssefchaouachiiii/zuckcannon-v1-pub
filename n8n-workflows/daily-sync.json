    {
      "parameters": {
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/active-rules",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.ZUCKCANNON_SECRET }}"
            }
          ]
        },
        "options": {}
