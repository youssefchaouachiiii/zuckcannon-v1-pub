      "id": "a1b2c3d4-0002-4e5f-8a9b-000000000002",
      "name": "Fetch RT Daily Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        -128
      ],
