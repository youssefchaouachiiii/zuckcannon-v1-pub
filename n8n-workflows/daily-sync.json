      "id": "a1b2c3d4-0006-4e5f-8a9b-000000000006",
      "name": "Fetch Active Entities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const rules = $input.all().map(i => i.json);\nconst seen = new Set();\nconst entities = [];\nfor (const rule of rules) {\n  for (const e of (rule.entities || [])) {\n    if (!seen.has(e.entityId)) {\n      seen.add(e.entityId);\n      entities.push({ entityId: e.entityId, token: e.token });\n    }\n  }\n}\nif (entities.length === 0) return [{ json: { skip: true } }];\nconst token = entities[0].token;\nconst since = $now.minus({days: 14}).toFormat('yyyy-MM-dd');\nconst until = $now.minus({days: 1}).toFormat('yyyy-MM-dd');\nconst MAX = 24;\nconst chunks = [];\nfor (let i = 0; i < entities.length; i += MAX) {\n  const chunk = entities.slice(i, i + MAX);\n  const batch = chunk.map(e => ({\n    method: 'GET',\n    relative_url: `${e.entityId}/insights?fields=spend,actions,action_values,ctr,cpc,frequency,inline_link_clicks,outbound_clicks_ctr&time_range={\"since\":\"${since}\",\"until\":\"${until}\"}&time_increment=1`\n  }));\n  chunks.push({ json: { batch, token, entityChunk: chunk } });\n}\nreturn chunks;"
      },
      "id": "a1b2c3d4-0007-4e5f-8a9b-000000000007",
      "name": "Build FB Daily Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        128
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "a1b2c3d4-0008-4e5f-8a9b-000000000008",
      "name": "Split Chunks",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        672,
        128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "batch",
              "value": "={{ JSON.stringify($json.batch) }}"
            },
            {
              "name": "access_token",
              "value": "={{ $json.token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0009-4e5f-8a9b-000000000009",
      "name": "FB Batch API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        128
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const chunkMeta = $('Build FB Daily Batch').item.json;\nconst responses = $input.all().map(i => i.json);\nconst rows = [];\nfor (let i = 0; i < responses.length; i++) {\n  const entity = chunkMeta.entityChunk[i];\n  if (!entity) continue;\n  const resp = responses[i];\n  if (!resp || resp.code !== 200) continue;\n  let body;\n  try { body = JSON.parse(resp.body); } catch { continue; }\n  for (const day of (body.data || [])) {\n    const spend = parseFloat(day.spend || 0);\n    const conversions = parseFloat(day.actions?.find(a => a.action_type === 'purchase')?.value || 0);\n    const revenue = parseFloat(day.action_values?.find(a => a.action_type === 'purchase')?.value || 0);\n    const ctr = parseFloat(day.ctr || 0);\n    const cpc = parseFloat(day.cpc || 0);\n    const frequency = parseFloat(day.frequency || 0);\n    const link_clicks = parseFloat(day.inline_link_clicks || 0);\n    const lp_views = parseFloat(day.actions?.find(a => a.action_type === 'landing_page_view')?.value || 0);\n    const initiate_checkout = parseFloat(day.actions?.find(a => a.action_type === 'initiate_checkout')?.value || 0);\n    const outbound_clicks = parseFloat(day.outbound_clicks_ctr?.[0]?.value || 0);\n    rows.push({\n      entity_id: entity.entityId,\n      entity_type: 'campaign',\n      date: day.date_start,\n      spend, conversions, revenue,\n      ctr, cpc, frequency, link_clicks, lp_views, initiate_checkout, outbound_clicks\n    });\n  }\n}\nreturn [{ json: { rows } }];"
      },
      "id": "a1b2c3d4-0010-4e5f-8a9b-000000000010",
