    {
      "id": "node-fetch-budget",
      "name": "Fetch Current Budget",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4420, -200],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v25.0/{{ $('Evaluate Rules').item.json.entityId }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "daily_budget" },
            { "name": "access_token", "value": "={{ $('Evaluate Rules').item.json.token }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-compute-scale",
      "name": "Compute Scale Budget",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4640, -200],
      "parameters": {
        "jsCode": "const { entityId, entityName, rule, metrics, token } = $('Evaluate Rules').item.json;\nconst currentBudgetCents = parseInt($input.item.json.daily_budget || 0);\nconst scaledCents = Math.round(currentBudgetCents * 1.2);\nconst maxCents = rule.action_params?.max_budget ? rule.action_params.max_budget * 100 : Infinity;\nconst newBudgetCents = Math.min(scaledCents, maxCents);\nreturn [{ json: { entityId, entityName, rule, metrics, token, newBudgetCents } }];"
      }
    },
    {
      "id": "node-call-fb-scale",
      "name": "Call FB API Scale",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4860, -200],
      "parameters": {
