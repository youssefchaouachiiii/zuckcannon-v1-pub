          "conditions": [{ "id": "cond-learning", "leftValue": "={{ $json.learning_stage_info?.status }}", "rightValue": "LEARNING", "operator": { "type": "string", "operation": "notEquals" } }],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-build-action",
      "name": "Build FB Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3980, 0],
      "parameters": {
        "jsCode": "const { rule, entityId, entityName, metrics, token } = $('Evaluate Rules').item.json;\n\nlet body = {};\nif (rule.action === 'pause') body = { status: 'PAUSED', access_token: token };\nelse if (rule.action === 'enable') body = { status: 'ACTIVE', access_token: token };\n// scale_budget: handled by Fetch Current Budget → Compute Scale Budget → Call FB API Scale\n\nreturn [{ json: { entityId, entityName, body, rule, metrics, token } }];"
      }
    },
