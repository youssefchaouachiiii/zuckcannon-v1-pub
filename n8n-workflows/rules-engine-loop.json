      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 2 }] }
      }
    },
    {
      "id": "node-get-rules",
      "name": "Get Active Rules",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/active-rules",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-n8n-secret", "value": "={{ $env.ZUCKCANNON_SECRET }}" }] },
        "options": {}
      }
    },
    {
      "id": "node-split-rules",
      "name": "Split Rules",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "node-build-batch",
      "name": "Build FB Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "jsCode": "const rule = $input.item.json;\nconst entities = rule.entities || [];\n\nif (entities.length === 0) return [{ json: { skip: true, reason: 'No entities', rule } }];\n\nconst token = entities[0]?.token || null;\nif (!token) return [{ json: { skip: true, reason: 'No token', rule } }];\n\nconst conditions = rule.conditions || [];\nconst needsMultiDay = conditions.some(c => c.lookback === 'last_3d' || c.lookback === 'last_7d');\n\nconst batch = [\n  ...entities.map(e => ({ method: 'GET', relative_url: `${e.entityId}?fields=effective_status,name` })),\n  ...entities.map(e => ({ method: 'GET', relative_url: `${e.entityId}/insights?fields=spend,actions,action_values,purchase_roas,cost_per_action_type&date_preset=today` })),\n  ...(needsMultiDay ? entities.map(e => ({ method: 'GET', relative_url: `${e.entityId}/insights?fields=spend,actions,action_values,purchase_roas,cost_per_action_type&date_preset=last_3_days` })) : []),\n];\n\nreturn [{ json: { rule, entities, batch, token, needsMultiDay } }];"
      }
    },
    {
      "id": "node-has-data",
      "name": "Has Data?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "id": "cond-skip", "leftValue": "={{ $json.skip }}", "rightValue": true, "operator": { "type": "boolean", "operation": "notEquals" } }],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-fb-batch-api",
      "name": "FB Batch API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "batch", "value": "={{ JSON.stringify($json.batch) }}" },
            { "name": "access_token", "value": "={{ $json.token }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-save-snapshots",
      "name": "Save Snapshots",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/snapshots",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-n8n-secret", "value": "={{ $env.ZUCKCANNON_SECRET }}" }] },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($('Build FB Batch').item.json.entities.map(e => ({ entity_id: e.entityId, entity_type: $('Build FB Batch').item.json.rule.scope, spend: 0 }))) }}",
        "options": { "onError": "continueRegularOutput" }
      }
    },
    {
      "id": "node-compute-burst",
      "name": "Compute Burst",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 200],
      "parameters": {
        "jsCode": "const batchData = $input.item.json;\nreturn [{ json: { ...batchData, _burstReady: true } }];"
      }
    },
    {
      "id": "node-evaluate-rules",
      "name": "Evaluate Rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 200],
      "parameters": {
        "jsCode": "const { rule, entities, token, needsMultiDay } = $('Build FB Batch').item.json;\nconst responses = $('FB Batch API').all().map(i => i.json);\nconst n = entities.length;\n\nfunction parseInsights(resp) {\n  if (!resp || resp.code !== 200) return null;\n  let body; try { body = JSON.parse(resp.body); } catch { return null; }\n  const d = body?.data?.[0];\n  if (!d) return null;\n  const spend = parseFloat(d.spend || 0);\n  const conversions = parseFloat(d.actions?.find(a => a.action_type === 'purchase')?.value || 0);\n  const cpa = conversions > 0 ? spend / conversions : 0;\n  const roas = parseFloat(d.purchase_roas?.[0]?.value || 0);\n  const purchaseValue = parseFloat(d.action_values?.find(a => a.action_type === 'purchase')?.value || 0);\n  const roi = spend > 0 ? (purchaseValue - spend) / spend : 0;\n  return { spend_today: spend, conversions, cpa, roas, roi };\n}\n\nconst conditions = rule.conditions || [];\nconst combinator = rule.combinator || 'AND';\nconst triggered = [];\n\nfor (let i = 0; i < n; i++) {\n  const entity = entities[i];\n  const entityId = entity.entityId;\n  const entityToken = entity.token || token;\n\n  const statusResp = responses[i];\n  let entityName = entityId;\n  if (statusResp?.code === 200) {\n    let sb; try { sb = JSON.parse(statusResp.body); } catch {}\n    entityName = sb?.name || entityId;\n    if (sb?.effective_status === 'PAUSED' && rule.action !== 'enable') continue;\n  }\n\n  const todayInsights = parseInsights(responses[n + i]);\n  const multiInsights = needsMultiDay ? parseInsights(responses[2 * n + i]) : todayInsights;\n  if (!todayInsights) continue;\n\n  const evaluate = (c) => {\n    const src = (c.lookback === 'last_3d' || c.lookback === 'last_7d') ? multiInsights : todayInsights;\n    const val = src?.[c.metric];\n    if (val === undefined || val === null) return false;\n    switch (c.operator) {\n      case 'gt':  return val > c.value;\n      case 'lt':  return val < c.value;\n      case 'gte': return val >= c.value;\n      case 'lte': return val <= c.value;\n      case 'eq':  return val === c.value;\n      default:    return false;\n    }\n  };\n\n  const allMet = combinator === 'OR' ? conditions.some(evaluate) : conditions.every(evaluate);\n  if (allMet) {\n    triggered.push({ json: { rule, entityId, entityName, metrics: todayInsights, token: entityToken } });\n  }\n}\n\n// Account cap: aggregate total spend across all entities\nif (rule.scope === 'account' && conditions.length > 0) {\n  const totalSpend = triggered.reduce((sum, t) => sum + (t.json.metrics.spend_today || 0), 0);\n  const condition = conditions[0];\n  if (condition && totalSpend > condition.value) {\n    return [{ json: { rule, entityId: 'ALL', entityName: 'All Campaigns', metrics: { spend_today: totalSpend }, token, isAccountCap: true } }];\n  }\n  return [{ json: { noTrigger: true } }];\n}\n\nreturn triggered.length > 0 ? triggered : [{ json: { noTrigger: true } }];"
      }
    },
    {
      "id": "node-has-trigger",
      "name": "Has Trigger?",
      "type": "n8n-nodes-base.if",
