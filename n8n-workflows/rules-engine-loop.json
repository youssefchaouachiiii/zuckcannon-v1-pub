        "url": "=https://graph.facebook.com/v25.0/{{ $json.entityId }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "daily_budget", "value": "={{ $json.newBudgetCents }}" },
            { "name": "access_token", "value": "={{ $json.token }}" }
          ]
        },
        "options": {}
      }
    },
