{
  "name": "Rules Engine Loop",
  "nodes": [
    {
      "id": "node-schedule-1",
      "name": "Every 2 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "node-get-rules",
      "name": "Get Active Rules",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/active-rules",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-secret", "value": "={{ $env.N8N_SHARED_SECRET }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-split-rules",
      "name": "Split Rules",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "node-build-batch",
      "name": "Build FB Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "jsCode": "const rule = $input.item.json;\nconst entities = rule.entities || [];\nconst token = rule.token;\n\nif (!token) {\n  return [{ json: { skip: true, reason: 'No token', rule } }];\n}\n\nif (entities.length === 0) {\n  return [{ json: { skip: true, reason: 'No entities', rule } }];\n}\n\nconst batch = entities.map(entityId => ({\n  method: 'GET',\n  relative_url: `${entityId}/insights?fields=spend,actions,action_values,purchase_roas,cost_per_action_type&date_preset=today`,\n}));\n\nreturn [{ json: { rule, token, batch, entities } }];"
      }
    },
    {
      "id": "node-has-data",
      "name": "Has Data?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-skip",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-fb-batch-api",
      "name": "FB Batch API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "batch", "value": "={{ JSON.stringify($json.batch) }}" },
            { "name": "access_token", "value": "={{ $json.token }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-evaluate-rules",
      "name": "Evaluate Rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 200],
      "parameters": {
        "jsCode": "const { rule, entities, token } = $('Build FB Batch').item.json;\nconst batchResponses = $input.item.json;\n\nconst responses = Array.isArray(batchResponses) ? batchResponses : [batchResponses];\n\nconst triggered = [];\n\nfor (let i = 0; i < responses.length; i++) {\n  const resp = responses[i];\n  if (!resp || resp.code !== 200) continue;\n\n  let body;\n  try { body = JSON.parse(resp.body); } catch { continue; }\n\n  const insights = body?.data?.[0];\n  if (!insights) continue;\n\n  const entityId = entities[i];\n\n  const spend = parseFloat(insights.spend || 0);\n  const conversions = parseFloat(\n    insights.actions?.find(a => a.action_type === 'purchase')?.value || 0\n  );\n  const cpa = conversions > 0 ? spend / conversions : 0;\n  const roas = parseFloat(insights.purchase_roas?.[0]?.value || 0);\n  const purchaseValue = parseFloat(\n    insights.action_values?.find(a => a.action_type === 'purchase')?.value || 0\n  );\n  const roi = spend > 0 ? (purchaseValue - spend) / spend : 0;\n\n  const metrics = { spend_today: spend, conversions, cpa, roas, roi };\n\n  const conditions = rule.conditions || [];\n  const allMet = conditions.length > 0 && conditions.every(c => {\n    const val = metrics[c.metric];\n    if (val === undefined || val === null) return false;\n    switch (c.operator) {\n      case 'gt':  return val > c.value;\n      case 'lt':  return val < c.value;\n      case 'gte': return val >= c.value;\n      case 'lte': return val <= c.value;\n      case 'eq':  return val === c.value;\n      default:    return false;\n    }\n  });\n\n  if (allMet) {\n    triggered.push({ json: { rule, entityId, metrics, token } });\n  }\n}\n\nreturn triggered.length > 0 ? triggered : [{ json: { noTrigger: true } }];"
      }
    },
    {
      "id": "node-has-trigger",
      "name": "Has Trigger?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-no-trigger",
              "leftValue": "={{ $json.noTrigger }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-check-exemption",
      "name": "Check Exemption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 100],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/exemptions/check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-secret", "value": "={{ $env.N8N_SHARED_SECRET }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "rule_id", "value": "={{ $json.rule.id }}" },
            { "name": "entity_id", "value": "={{ $json.entityId }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-not-exempt",
      "name": "Not Exempt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2220, 100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-exempt",
              "leftValue": "={{ $json.exempt }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-is-dry-run",
      "name": "Is Dry Run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2440, 100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-dry-run",
              "leftValue": "={{ $('Evaluate Rules').item.json.rule.is_dry_run }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-build-action",
      "name": "Build FB Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 0],
      "parameters": {
        "jsCode": "const { rule, entityId, metrics, token } = $('Evaluate Rules').item.json;\n\nlet body = {};\n\nif (rule.action === 'pause') {\n  body = { status: 'PAUSED', access_token: token };\n} else if (rule.action === 'enable') {\n  body = { status: 'ACTIVE', access_token: token };\n} else if (rule.action === 'scale_budget') {\n  const cap = rule.action_params?.cap || 500;\n  body = { daily_budget: cap * 100, access_token: token };\n}\n\nreturn [{ json: { entityId, body, rule, metrics, token } }];"
      }
    },
    {
      "id": "node-call-fb-api",
      "name": "Call FB API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2880, 0],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.entityId }}",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "status", "value": "={{ $json.body.status }}" },
            { "name": "access_token", "value": "={{ $json.token }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-telegram-alert",
      "name": "Telegram Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3100, 0],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"chat_id\": \"{{ $env.TELEGRAM_CHAT_ID }}\",\n  \"text\": \"\\ud83d\\uded1 *{{ $('Evaluate Rules').item.json.rule.name }}*\\n`{{ $('Evaluate Rules').item.json.entityId }}`  {{ $('Evaluate Rules').item.json.rule.action.toUpperCase() }}D\\nSpend: ${{ $('Evaluate Rules').item.json.metrics.spend_today.toFixed(2) }}\\n{{ new Date().toLocaleTimeString('en-US', {timeZone: 'America/New_York'}) }} ET\",\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {}
      }
    },
    {
      "id": "node-log-action",
      "name": "Log Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3320, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-secret", "value": "={{ $env.N8N_SHARED_SECRET }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"rule_id\": {{ $('Evaluate Rules').item.json.rule.id }},\n  \"entity_type\": \"{{ $('Evaluate Rules').item.json.rule.scope }}\",\n  \"entity_id\": \"{{ $('Evaluate Rules').item.json.entityId }}\",\n  \"entity_name\": \"{{ $('Evaluate Rules').item.json.entityId }}\",\n  \"action_taken\": \"{{ $('Evaluate Rules').item.json.rule.action }}d\",\n  \"trigger_data_json\": {{ JSON.stringify(JSON.stringify($('Evaluate Rules').item.json.metrics)) }},\n  \"is_dry_run\": 0\n}",
        "options": {}
      }
    },
    {
      "id": "node-log-dry-run",
      "name": "Log Dry Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2660, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-secret", "value": "={{ $env.N8N_SHARED_SECRET }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"rule_id\": {{ $('Evaluate Rules').item.json.rule.id }},\n  \"entity_type\": \"{{ $('Evaluate Rules').item.json.rule.scope }}\",\n  \"entity_id\": \"{{ $('Evaluate Rules').item.json.entityId }}\",\n  \"entity_name\": \"{{ $('Evaluate Rules').item.json.entityId }}\",\n  \"action_taken\": \"would_have_{{ $('Evaluate Rules').item.json.rule.action }}d\",\n  \"trigger_data_json\": {{ JSON.stringify(JSON.stringify($('Evaluate Rules').item.json.metrics)) }},\n  \"is_dry_run\": 1\n}",
        "options": {}
      }
    },
    {
      "id": "node-set-cooldown",
      "name": "Set Cooldown",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3540, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/exemptions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-secret", "value": "={{ $env.N8N_SHARED_SECRET }}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"rule_id\": {{ $('Evaluate Rules').item.json.rule.id }},\n  \"entity_id\": \"{{ $('Evaluate Rules').item.json.entityId }}\",\n  \"type\": \"cooldown\",\n  \"cooldown_hours\": {{ $('Evaluate Rules').item.json.rule.cooldown_hours || 4 }}\n}",
        "options": {}
      }
    }
  ],
  "connections": {
