          "conditions": [{ "id": "cond-scale", "leftValue": "={{ $('Evaluate Rules').item.json.rule.action }}", "rightValue": "scale_budget", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        }
      }
