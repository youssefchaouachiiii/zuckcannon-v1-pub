{
  "name": "Daily Digest + Token Health",
  "nodes": [
    {
      "id": "node-schedule-trigger",
      "name": "Daily 23:55 ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "55 23 * * *" }]
        },
        "triggerAtTimezone": "America/New_York"
      }
    },
    {
      "id": "node-get-logs",
      "name": "Get Today's Logs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/logs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "date", "value": "={{ new Date().toISOString().split('T')[0] }}" },
            { "name": "limit", "value": "=500" }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-aggregate",
      "name": "Aggregate Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "const logs = $input.all().map(i => i.json);\n\nconst rulesFired = logs.filter(l => !l.is_dry_run).length;\nconst paused = logs.filter(l => l.action_taken === 'paused').length;\nconst scaled = logs.filter(l => l.action_taken === 'scaled').length;\nconst dryRun = logs.filter(l => l.is_dry_run).length;\nconst date = new Date().toLocaleDateString('en-US', {\n  timeZone: 'America/New_York',\n  month: 'short', day: 'numeric', year: 'numeric'\n});\n\nreturn [{ json: { date, rulesFired, paused, scaled, dryRun, total: logs.length } }];"
      }
    },
    {
      "id": "node-send-digest",
      "name": "Send Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"chat_id\": \"{{ $env.TELEGRAM_CHAT_ID }}\",\n  \"text\": \"\\ud83d\\udcca *Daily Digest \\u2014 {{ $json.date }}*\\n\\nRules Fired: {{ $json.rulesFired }}\\nPaused: {{ $json.paused }}  |  Scaled: {{ $json.scaled }}\\nDry Run Only: {{ $json.dryRun }}\\n\\nSystem: \\u2705 OK\",\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {}
      }
    },
    {
      "id": "node-email-digest",
      "name": "Email Digest",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1120, 300],
      "credentials": {
        "smtp": {
          "id": "CONFIGURE_IN_N8N",
          "name": "SMTP (configure in n8n)"
        }
      },
      "parameters": {
        "fromEmail": "={{ $env.SMTP_USER }}",
        "toEmail": "={{ $env.ALERT_EMAIL_TO }}",
        "subject": "=📊 Daily Digest — {{ $('Aggregate Stats').item.json.date }}",
        "emailFormat": "html",
        "html": "=<h2>Daily Digest — {{ $('Aggregate Stats').item.json.date }}</h2>\n<table style=\"border-collapse:collapse;font-family:sans-serif;\">\n  <tr><td style=\"padding:6px 12px;\"><b>Rules Fired</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.rulesFired }}</td></tr>\n  <tr><td style=\"padding:6px 12px;\"><b>Paused</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.paused }}</td></tr>\n  <tr><td style=\"padding:6px 12px;\"><b>Scaled</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.scaled }}</td></tr>\n  <tr><td style=\"padding:6px 12px;\"><b>Dry Run Only</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.dryRun }}</td></tr>\n  <tr><td style=\"padding:6px 12px;\"><b>Total Events</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.total }}</td></tr>\n</table>",
        "options": { "allowUnauthorizedCerts": false }
      }
    },
    {
      "id": "node-get-tokens",
      "name": "Get Tokens",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/tokens",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-check-expiry",
      "name": "Check Token Expiry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300],
      "parameters": {
        "jsCode": "const tokens = $input.all().map(i => i.json);\nconst warnings = tokens.filter(t => {\n  if (!t.expires_at) return false;\n  const daysLeft = (new Date(t.expires_at) - new Date()) / 86400000;\n  return daysLeft <= 7;\n});\nreturn warnings.length > 0\n  ? warnings.map(t => ({ json: t }))\n  : [{ json: { noWarnings: true } }];"
      }
    },
    {
      "id": "node-has-warning",
      "name": "Token Warning?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-no-warnings",
              "leftValue": "={{ $json.noWarnings }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-token-warning",
      "name": "Token Warning Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 200],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"chat_id\": \"{{ $env.TELEGRAM_CHAT_ID }}\",\n  \"text\": \"\\u26a0\\ufe0f *Token Expiring Soon*\\nBusiness: {{ $json.business_name }}\\nExpires: {{ $json.expires_at }}\\n\\nRenew at Facebook Business Manager \\u2192 System Users\",\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Daily 23:55 ET": {
      "main": [[{ "node": "Get Today's Logs", "type": "main", "index": 0 }]]
    },
    "Get Today's Logs": {
      "main": [[{ "node": "Aggregate Stats", "type": "main", "index": 0 }]]
    },
    "Aggregate Stats": {
      "main": [[{ "node": "Send Digest", "type": "main", "index": 0 }]]
    },
    "Send Digest": {
      "main": [[{ "node": "Email Digest", "type": "main", "index": 0 }]]
    },
    "Email Digest": {
      "main": [[{ "node": "Get Tokens", "type": "main", "index": 0 }]]
    },
    "Get Tokens": {
      "main": [[{ "node": "Check Token Expiry", "type": "main", "index": 0 }]]
    },
    "Check Token Expiry": {
      "main": [[{ "node": "Token Warning?", "type": "main", "index": 0 }]]
    },
    "Token Warning?": {
      "main": [
        [{ "node": "Token Warning Alert", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
