{
  "name": "Daily Digest + Token Health",
  "nodes": [
    {
      "id": "node-schedule-trigger",
      "name": "Daily 23:55 ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "55 23 * * *" }]
        },
        "triggerAtTimezone": "America/New_York"
      }
    },
    {
      "id": "node-get-logs",
      "name": "Get Today's Logs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 200],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/logs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "date", "value": "={{ new Date().toISOString().split('T')[0] }}" },
            { "name": "limit", "value": "=500" }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-get-coverage",
      "name": "Get Coverage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/ui/coverage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-aggregate",
      "name": "Aggregate Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "const logs = $('Get Today\\'s Logs').all().map(i => i.json);\nconst coverage = $('Get Coverage').all().map(i => i.json);\n\nconst rulesFired = logs.filter(l => !l.is_dry_run).length;\nconst paused = logs.filter(l => l.action_taken === 'paused').length;\nconst scaled = logs.filter(l => l.action_taken === 'scaled').length;\nconst dryRun = logs.filter(l => l.is_dry_run).length;\nconst orphans = coverage.length;\nconst date = new Date().toLocaleDateString('en-US', {\n  timeZone: 'America/New_York',\n  month: 'long', day: 'numeric', year: 'numeric'\n});\n\nreturn [{ json: { date, rulesFired, paused, scaled, dryRun, orphans, total: logs.length } }];"
      }
    },
    {
      "id": "node-send-digest",
      "name": "Send Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: '📊 *Daily Digest — ' + $json.date + '*\\n\\nRules Fired: ' + $json.rulesFired + '  |  Paused: ' + $json.paused + '  |  Scaled: ' + $json.scaled + '\\nOrphans: ' + $json.orphans + '  |  System: ✅ OK', parse_mode: 'Markdown' }) }}",
        "options": {}
      }
    },
    {
      "id": "node-email-digest",
      "name": "Email Digest",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1120, 300],
      "credentials": {
        "gmailOAuth2": { "id": "gBEVUYvaXvzCfV8P", "name": "info@sigmagrowthpartners.com account" }
      },
      "parameters": {
        "sendTo": "={{ $env.ALERT_EMAIL_TO }}",
        "subject": "=📊 Daily Digest — {{ $('Aggregate Stats').item.json.date }}",
        "emailType": "html",
        "message": "=<h2>📊 Daily Digest — {{ $('Aggregate Stats').item.json.date }}</h2><table style=\"border-collapse:collapse;font-family:sans-serif;\"><tr><td style=\"padding:6px 12px;\"><b>Rules Fired</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.rulesFired }}</td></tr><tr><td style=\"padding:6px 12px;\"><b>Paused</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.paused }}</td></tr><tr><td style=\"padding:6px 12px;\"><b>Scaled</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.scaled }}</td></tr><tr><td style=\"padding:6px 12px;\"><b>Dry Run Only</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.dryRun }}</td></tr><tr><td style=\"padding:6px 12px;\"><b>Orphans</b></td><td style=\"padding:6px 12px;\">{{ $('Aggregate Stats').item.json.orphans }}</td></tr><tr><td style=\"padding:6px 12px;\"><b>System</b></td><td style=\"padding:6px 12px;\">✅ OK</td></tr></table>",
        "options": {}
      }
    },
    {
      "id": "node-get-tokens",
      "name": "Get Tokens",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZUCKCANNON_URL }}/api/rules-engine/tokens",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Zuckcannon Secret" }
      }
    },
    {
      "id": "node-check-expiry",
      "name": "Check Token Expiry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300],
      "parameters": {
        "jsCode": "const tokens = $input.all().map(i => i.json);\nconst warnings = tokens.filter(t => {\n  if (!t.expires_at) return false;\n  const daysLeft = (new Date(t.expires_at) - new Date()) / 86400000;\n  return daysLeft <= 7;\n});\nreturn warnings.length > 0\n  ? warnings.map(t => ({ json: t }))\n  : [{ json: { noWarnings: true } }];"
      }
    },
    {
      "id": "node-has-warning",
      "name": "Token Warning?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-no-warnings",
              "leftValue": "={{ $json.noWarnings }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node-token-warning",
      "name": "Token Warning Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 200],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: '⚠️ *Token Expiring Soon*\\nBusiness: ' + $json.business_name + '\\nExpires: ' + $json.expires_at + '\\n\\nRenew at Facebook Business Manager → System Users', parse_mode: 'Markdown' }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Daily 23:55 ET": {
      "main": [[
        { "node": "Get Today's Logs", "type": "main", "index": 0 },
        { "node": "Get Coverage", "type": "main", "index": 0 }
      ]]
    },
    "Get Today's Logs": {
      "main": [[{ "node": "Aggregate Stats", "type": "main", "index": 0 }]]
    },
    "Get Coverage": {
      "main": [[{ "node": "Aggregate Stats", "type": "main", "index": 0 }]]
    },
    "Aggregate Stats": {
      "main": [[{ "node": "Send Digest", "type": "main", "index": 0 }]]
    },
    "Send Digest": {
      "main": [[{ "node": "Email Digest", "type": "main", "index": 0 }]]
    },
    "Email Digest": {
      "main": [[{ "node": "Get Tokens", "type": "main", "index": 0 }]]
    },
    "Get Tokens": {
      "main": [[{ "node": "Check Token Expiry", "type": "main", "index": 0 }]]
    },
    "Check Token Expiry": {
      "main": [[{ "node": "Token Warning?", "type": "main", "index": 0 }]]
    },
    "Token Warning?": {
      "main": [
        [{ "node": "Token Warning Alert", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
