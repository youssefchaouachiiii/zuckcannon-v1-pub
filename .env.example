# Environment variables for production server
# Copy this file to /root/zuck/.env on your server and fill in actual values

# Application
NODE_ENV=production
PORT=3000

# Database (if using SQLite)
DATABASE_PATH=./data/db/app.db

# Authentication
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Multi-BM: route ads-ops WRITES through system-user tokens (per-ad-account → BM)
# instead of the logged-in OAuth user token. Default off → writes use OAuth
# (unchanged behavior). Flip to 'true' only after a system user is registered
# and smoke-tested on 1 BM. Reads always route via system-user with OAuth fallback.
USE_SYSTEM_USER_FOR_WRITES=false

# Multi-BM strict mode: when system-user routing finds no healthy system user for
# an account's BM, HARD-FAIL the request (HTTP 403 'no_fb_token_for_account',
# detail 'strict_mode_no_system_user') instead of falling back to the personal
# OAuth token. Default off → OAuth fallback unchanged. Flip to 'true' ONLY after at
# least one healthy system user is confirmed in prod, or writes for un-provisioned
# BMs will start returning 403.
OAUTH_STRICT_ADS_OPS=false

# File Uploads
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=./uploads

# Session
SESSION_SECRET=your_secure_random_session_secret

# API Keys
YOUTUBE_API_KEY=your_youtube_api_key

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=https://yourdomain.com

# Redis (optional, for session store)
REDIS_URL=redis://localhost:6379
